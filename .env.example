# Skopiuj ten plik do ".env" i wstaw swój connection string z Supabase.
# Project Settings → Database → Connection string → zakładka "Transaction pooler"
# (nie "Direct connection" ani "Session pooler" — patrz README.md, sekcja Setup).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
